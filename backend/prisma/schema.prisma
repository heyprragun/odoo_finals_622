generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES_REP
  MANAGER
  FINANCE
  CUSTOMER
  ADMIN
}

enum ProductCategory {
  HARDWARE
  SERVICE
  SUBSCRIPTION
}

enum CustomerTier {
  GOLD
  SILVER
  BRONZE
}

enum CustomerRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CONVERTED
  CANCELLED
}

// SUBMITTED is kept for schema/history stability but is no longer a resting
// state for new quotes - submitQuote() evaluates risk immediately and routes
// straight to one of the outcomes below.
enum QuoteStatus {
  DRAFT
  SUBMITTED
  PENDING_MANAGER_APPROVAL
  PENDING_FINANCE_APPROVAL
  // Master approval gate: every quote passes through here - regardless of
  // risk level or which of the stages above it went through - before it can
  // become APPROVED. No quote is "confirmed" without Admin sign-off.
  PENDING_ADMIN_APPROVAL
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum QuoteAuditAction {
  SUBMITTED
  AUTO_APPROVED
  APPROVED
  RETURNED
  REJECTED
  RESUBMITTED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionEventType {
  CREATED
  PAUSED
  RESUMED
  CANCELLED
  QUANTITY_CHANGED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Links a CUSTOMER-role user to their company record. Unused by other roles today;
  // reserved for the future customer portal's resource-ownership checks.
  customerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer     Customer?         @relation(fields: [customerId], references: [id])
  quotes       Quote[]           @relation("SalesRepQuotes")
  auditEntries QuoteAuditEntry[]

  @@map("users")
}

model Product {
  id          String          @id @default(uuid())
  name        String
  sku         String          @unique
  category    ProductCategory
  description String?
  unitPrice   Decimal         @default(0) @db.Decimal(12, 2)
  cost        Decimal         @default(0) @db.Decimal(12, 2)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  requestItems  CustomerRequestItem[]
  quoteItems    QuoteItem[]
  inventory     Inventory[]
  subscriptions Subscription[]

  @@map("products")
}

// Admin-configurable per-category discount ceiling used by the approval
// risk engine. One row per category; seeded with defaults for now since the
// Admin config UI to edit these is a future phase.
model CategoryDiscountLimit {
  id                    String          @id @default(uuid())
  category              ProductCategory @unique
  maxDiscountPercentage Decimal         @db.Decimal(5, 2)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("category_discount_limits")
}

model Customer {
  id        String       @id @default(uuid())
  name      String
  tier      CustomerTier
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users            User[]
  customerRequests CustomerRequest[]
  quotes           Quote[]
  subscriptions    Subscription[]
  invoices         Invoice[]

  @@map("customers")
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]

  @@map("warehouses")
}

model Inventory {
  id                String   @id @default(uuid())
  warehouseId       String
  productId         String
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  updatedAt         DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("inventory")
}

model CustomerRequest {
  id         String                @id @default(uuid())
  customerId String
  status     CustomerRequestStatus @default(NEW)
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  customer Customer              @relation(fields: [customerId], references: [id])
  items    CustomerRequestItem[]
  // A request converts into at most one quotation - enforced by the @unique
  // on Quote.customerRequestId below, not just application logic.
  quote    Quote?

  @@map("customer_requests")
}

model CustomerRequestItem {
  id                String  @id @default(uuid())
  customerRequestId String
  productId         String
  requestedQuantity Int
  notes             String?

  customerRequest CustomerRequest @relation(fields: [customerRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@map("customer_request_items")
}

model Quote {
  id                 String      @id @default(uuid())
  quoteNumber        String      @unique
  customerId         String
  salesRepId         String
  // Unique (nullable) so a request converts into AT MOST one quotation, while
  // quotes started without a request (customerRequestId null) are unrestricted.
  customerRequestId  String?     @unique
  status             QuoteStatus @default(DRAFT)
  // Set once at submit time by the discount-governance risk engine and left
  // untouched afterward, so routing/history stays consistent even if the
  // category ceilings are edited later.
  riskLevel          RiskLevel?
  subtotal           Decimal     @default(0) @db.Decimal(12, 2)
  // Sales-Rep-entered inputs; discountAmount/taxAmount below are the
  // backend-computed outputs derived from these percentages, never trusted
  // from the client directly.
  discountPercentage Decimal     @default(0) @db.Decimal(5, 2)
  taxPercentage      Decimal     @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal     @default(0) @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  customer        Customer          @relation(fields: [customerId], references: [id])
  salesRep        User              @relation("SalesRepQuotes", fields: [salesRepId], references: [id])
  customerRequest CustomerRequest?  @relation(fields: [customerRequestId], references: [id])
  items           QuoteItem[]
  auditEntries    QuoteAuditEntry[]
  subscriptions   Subscription[]
  invoices        Invoice[]

  @@map("quotes")
}

// Approval-workflow audit trail. Every submit/auto-approve/approve/return/
// reject action creates exactly one row here - this is intentionally scoped
// to the approval workflow, not the general-purpose audit system described
// for later phases (product edits, billing, etc.).
model QuoteAuditEntry {
  id        String           @id @default(uuid())
  quoteId   String
  userId    String
  action    QuoteAuditAction
  note      String?
  createdAt DateTime         @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("quote_audit_entries")
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("quote_items")
}

// Auto-created (one per subscription-category line item) the moment a
// quote reaches APPROVED - see subscription.service.ts. Not user-created
// directly; that keeps it traceable back to the originating quote.
model Subscription {
  id              String             @id @default(uuid())
  customerId      String
  productId       String
  quoteId         String?
  quantity        Int
  unitPrice       Decimal            @db.Decimal(12, 2)
  billingCycle    BillingCycle
  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime           @default(now())
  nextBillingDate DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  customer Customer            @relation(fields: [customerId], references: [id])
  product  Product             @relation(fields: [productId], references: [id])
  quote    Quote?              @relation(fields: [quoteId], references: [id])
  events   SubscriptionEvent[]
  invoices Invoice[]

  @@map("subscriptions")
}

// Recurring-order / proration history. Every lifecycle action (creation,
// pause, resume, cancel, quantity change) writes exactly one row here -
// this IS the "recurring orders" history shown on the company detail page.
model SubscriptionEvent {
  id             String                @id @default(uuid())
  subscriptionId String
  type           SubscriptionEventType
  // Signed: positive = charge, negative = credit (e.g. a mid-cycle quantity
  // decrease). Null for events with no direct billing impact (pause/resume).
  amount         Decimal?              @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime              @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_events")
}

// Auto-created the moment a quote reaches APPROVED - one one-time invoice
// covering that quote's non-subscription line items (if any), plus one
// recurring invoice per subscription-category line item (its first billing
// cycle). Not user-created directly. subscriptionId is null for a one-time
// invoice; quoteId is the quote that produced it either way.
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  customerId     String
  quoteId        String?
  subscriptionId String?
  amount         Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(UNPAID)
  issuedDate     DateTime      @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  quote        Quote?        @relation(fields: [quoteId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("invoices")
}
