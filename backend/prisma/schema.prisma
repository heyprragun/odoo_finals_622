generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SALES_REP
  MANAGER
  FINANCE
  CUSTOMER
  ADMIN
}

enum ProductCategory {
  HARDWARE
  SERVICE
  SUBSCRIPTION
}

enum CustomerTier {
  GOLD
  SILVER
  BRONZE
}

enum CustomerRequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  // Links a CUSTOMER-role user to their company record. Unused by other roles today;
  // reserved for the future customer portal's resource-ownership checks.
  customerId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id])
  quotes   Quote[]   @relation("SalesRepQuotes")

  @@map("users")
}

model Product {
  id        String          @id @default(uuid())
  name      String
  sku       String          @unique
  category  ProductCategory
  unitPrice Decimal         @default(0) @db.Decimal(12, 2)
  cost      Decimal         @default(0) @db.Decimal(12, 2)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  requestItems CustomerRequestItem[]
  quoteItems   QuoteItem[]
  inventory    Inventory[]

  @@map("products")
}

model Customer {
  id        String       @id @default(uuid())
  name      String
  tier      CustomerTier
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users            User[]
  customerRequests CustomerRequest[]
  quotes           Quote[]

  @@map("customers")
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  location  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory[]

  @@map("warehouses")
}

model Inventory {
  id                String   @id @default(uuid())
  warehouseId       String
  productId         String
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  updatedAt         DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("inventory")
}

model CustomerRequest {
  id         String                @id @default(uuid())
  customerId String
  status     CustomerRequestStatus @default(NEW)
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  customer Customer              @relation(fields: [customerId], references: [id])
  items    CustomerRequestItem[]
  quotes   Quote[]

  @@map("customer_requests")
}

model CustomerRequestItem {
  id                String  @id @default(uuid())
  customerRequestId String
  productId         String
  requestedQuantity Int
  notes             String?

  customerRequest CustomerRequest @relation(fields: [customerRequestId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])

  @@map("customer_request_items")
}

model Quote {
  id                String      @id @default(uuid())
  quoteNumber       String      @unique
  customerId        String
  salesRepId        String
  customerRequestId String?
  status            QuoteStatus @default(DRAFT)
  subtotal          Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal     @default(0) @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id])
  salesRep        User             @relation("SalesRepQuotes", fields: [salesRepId], references: [id])
  customerRequest CustomerRequest? @relation(fields: [customerRequestId], references: [id])
  items           QuoteItem[]

  @@map("quotes")
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("quote_items")
}
